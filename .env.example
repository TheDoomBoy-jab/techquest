# ==============================================================================
# TechQuest Clinical Adjudication Platform - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL KEYS / CONFIGURATION
# NEVER COMMIT .env OR REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Configurations
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Kado Agent Platform Configuration
KADO_BASE_URL=http://127.0.0.1:8000
KADO_MODEL=gpt-4o-mini
KADO_TIMEOUT_SECONDS=30

# A2A Communication
A2A_HOST=127.0.0.1
A2A_PORT=9000
A2A_SERVER_URL=http://127.0.0.1:9000
A2A_TIMEOUT_SECONDS=60

# Microservices Ports & Endpoints
COMPLIANCE_FASTAPI_PORT=8001
COMPLIANCE_AGENT_URL=http://127.0.0.1:8001
A2A_COMPLIANCE_URL=http://127.0.0.1:8001/a2a

SAFETY_FASTAPI_PORT=8002
SAFETY_AGENT_URL=http://127.0.0.1:8002
A2A_SAFETY_URL=http://127.0.0.1:8002/a2a

FINANCIAL_FASTAPI_PORT=8003
FINANCIAL_AGENT_URL=http://127.0.0.1:8003
A2A_FINANCIAL_URL=http://127.0.0.1:8003/a2a

# Orchestration Configuration
MAX_REFINEMENT_ITERATIONS=3
